PORTFOLIO_TOKEN=ghp_your_token_here
GITHUB_TOKEN=ghp_your_token_here

# Contact delivery (pick one or both)
CONTACT_TO_EMAIL=realchristiangarcia@gmail.com
# Optional: Resend (if unset, FormSubmit delivers to CONTACT_TO_EMAIL)
RESEND_API_KEY=re_your_key_here
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
# Optional: Slack incoming webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Optional spam protection
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Canonical site URL for sitemap/robots (set to your live Vercel/custom domain)
PUBLIC_SITE_URL=https://your-portfolio-domain.com
